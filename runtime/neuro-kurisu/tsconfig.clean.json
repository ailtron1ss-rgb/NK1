{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true
  },
  "include": [
    "src/organism/**/*.ts",
    "src/server/**/*.ts",
    "src/**/*.d.ts"
  ],
  "exclude": [
    "src/node-shims.d.ts"
  ]
}
