{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "typeRoots": ["../../app/node_modules/@types"],
    "types": ["node"]
  },
  "include": [
    "src/organism/**/*.ts",
    "src/server/**/*.ts",
    "src/**/*.d.ts"
  ]
}
