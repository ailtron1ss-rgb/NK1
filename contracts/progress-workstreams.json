{
  "schema": "nk1.progress-workstreams.v1",
  "note": "Weights are planning priorities, not measured quality. Artifact coverage is only file/script availability. Verified efficacy counts only evidence JSON with verified=true, an exact current HEAD SHA, and every explicit workstream metric threshold. No score may be raised by prose or by stale test artifacts.",
  "workstreams": [
    {
      "id": "W1-runtime-integrity",
      "title": "Runtime and cognitive-cycle integrity",
      "weight": 12,
      "endGoal": "One traceable Perceive->Plan->Gate->Act->Observe->Reflect->Consolidate path with no unverified bypass and a single versioned state.",
      "probes": [
        {
          "id": "cycle-boundary-test",
          "kind": "npm-script",
          "prefix": "runtime/neuro-kurisu",
          "script": "test:cognitive-cycle-boundary"
        },
        {
          "id": "cycle-runtime-wiring",
          "kind": "npm-script",
          "prefix": "runtime/neuro-kurisu",
          "script": "test:cognitive-cycle-boundary-runtime-wiring"
        },
        {
          "id": "cycle-contract",
          "kind": "npm-script",
          "prefix": "runtime/neuro-kurisu",
          "script": "test:workpass287:cognitive-cycle"
        }
      ],
      "evidenceProbes": [
        {
          "id": "deterministic-cycle-soak",
          "kind": "evidence-json",
          "path": "docs/evidence/cognitive-cycle-soak.json",
          "requirements": [
            {
              "path": "metrics.deterministicTicks",
              "op": "gte",
              "value": 10000
            },
            {
              "path": "metrics.maxTickMs",
              "op": "lte",
              "value": 50
            }
          ]
        }
      ]
    },
    {
      "id": "W2-memory-and-retrieval",
      "title": "Memory correctness and independent retrieval evidence",
      "weight": 16,
      "endGoal": "MemoryOS2 as the single owner, with proven recallDelta > 0 on an immutable RU/EN holdout across paired seeds, plus correct abstention and forgetting.",
      "probes": [
        {
          "id": "memory-restore-integrity",
          "kind": "npm-script",
          "prefix": "runtime/neuro-kurisu",
          "script": "test:memory-restore-integrity"
        },
        {
          "id": "memory-retrieval-benchmark",
          "kind": "npm-script",
          "prefix": "runtime/neuro-kurisu",
          "script": "test:memory-retrieval-benchmark"
        },
        {
          "id": "holdout-pairing-test",
          "kind": "file-exists",
          "path": "runtime/neuro-kurisu/tests/INDEPENDENT_BILINGUAL_HOLDOUT.md"
        }
      ],
      "evidenceProbes": [
        {
          "id": "retrieval-uplift-evidence",
          "kind": "evidence-json",
          "path": "docs/evidence/retrieval-uplift.json",
          "requirements": [
