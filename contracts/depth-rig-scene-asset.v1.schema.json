{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nk1.invalid/contracts/depth-rig-scene-asset.v1.schema.json",
  "title": "NK1 canonical 2.5D scene asset v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "rig",
    "artwork",
    "layers"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "rig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "id",
        "coordinateSystem",
        "nodes"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "coordinateSystem": {
          "const": "normalized-y-down"
        },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "role",
              "parentId",
              "depthOrder",
              "pivot",
              "rest"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "role": {
                "type": "string",
                "enum": [
                  "root",
                  "torso",
                  "neck",
                  "head",
                  "hair-back",
                  "hair-front",
                  "upper-arm-left",
                  "lower-arm-left",
                  "hand-left",
                  "upper-arm-right",
                  "lower-arm-right",
                  "hand-right",
                  "pelvis",
                  "upper-leg-left",
                  "lower-leg-left",
                  "foot-left",
                  "upper-leg-right",
                  "lower-leg-right",
                  "foot-right",
                  "garment",
                  "accessory",
                  "face-feature"
                ]
              },
              "parentId": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 64
              },
              "depthOrder": {
                "type": "integer",
                "minimum": -10000,
                "maximum": 10000
              },
              "pivot": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "x",
                  "y"
                ],
                "properties": {
                  "x": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "y": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                }
              },
              "rest": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "x",
                  "y",
                  "z",
                  "rotation",
                  "scaleX",
                  "scaleY"
                ],
                "properties": {
                  "x": {
                    "type": "number",
                    "minimum": -2,
                    "maximum": 2
                  },
                  "y": {
                    "type": "number",
                    "minimum": -2,
                    "maximum": 2
                  },
                  "z": {
                    "type": "number",
                    "minimum": -10,
                    "maximum": 10
                  },
                  "rotation": {
                    "type": "number",
                    "minimum": -360,
                    "maximum": 360
                  },
                  "scaleX": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 4
                  },
                  "scaleY": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 4
                  }
                }
              },
              "slot": {
                "type": "string",
                "maxLength": 64
              }
            }
          }
        }
      }
    },
    "artwork": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height",
        "units",
        "origin"
      ],
      "properties": {
        "width": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000
        },
        "units": {
          "const": "scene"
        },
        "origin": {
          "const": "center"
        }
      }
    },
    "layers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "nodeId",
          "objectName",
          "width",
          "height"
        ],
        "properties": {
          "nodeId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "objectName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "width": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1000
          },
          "height": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1000
          }
        }
      }
    }
  }
}
