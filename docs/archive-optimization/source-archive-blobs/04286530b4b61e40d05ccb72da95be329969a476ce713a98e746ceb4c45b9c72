import { OrganismRuntime } from '../src/organism/core/OrganismRuntime.ts';
import { MemoryStateStore } from '../src/organism/persistence/MemoryStateStore.ts';
import { BoundedOperationalJournal } from '../src/organism/persistence/BoundedOperationalJournal.ts';
const assert=(x,m)=>{if(!x)throw new Error(m)};
const store=new MemoryStateStore();
const r=new OrganismRuntime({stateFile:'b299-personality.json',worldStateFile:'b299-world.json',enableLanguage:false,performanceProfile:'mobile',stateStore:store,worldStateStore:store,journal:new BoundedOperationalJournal()});
await r.init();
const before=r.core.b299CausalPersonalitySnapshot();
const beforeBias=Object.fromEntries(['respond','explore','verify','rest','reflect','wait','defer'].map(a=>[a,r.core.b299CausalPersonalityBias(a)]));
for(let i=0;i<24;i++) await r.step(i%7===0?'Explore one uncertain possibility and compare consequences.':undefined);
const after=r.core.b299CausalPersonalitySnapshot();
const diag=r.core.b299CausalPersonalityDiagnostics();
const afterBias=Object.fromEntries(['respond','explore','verify','rest','reflect','wait','defer'].map(a=>[a,r.core.b299CausalPersonalityBias(a)]));
const beforeMagnitude=Object.values(beforeBias).reduce((s,v)=>s+Math.abs(v),0);
const afterMagnitude=Object.values(afterBias).reduce((s,v)=>s+Math.abs(v),0);
assert(diag.cycles===24,'B299 cycle count mismatch');
assert(diag.learningUpdates===24,'B299 did not learn on every live outcome');
assert(diag.verifiedUpdates>0,'B299 saw no verified outcomes');
assert(diag.autonomousUpdates>0,'B299 saw no autonomous outcomes');
assert(diag.contextCreditAssignments===24,'B300 contextual credit assignment did not run on every live outcome');
assert(Object.keys(diag.currentContext??{}).length===4,'B300 context state was not integrated into the live runtime');
assert(afterMagnitude>beforeMagnitude,'B299 did not create measurable personality action influence');
r.core.b299CausalPersonalityLesion(.95);
const lesioned=Object.values(Object.fromEntries(['respond','explore','verify','rest','reflect','wait','defer'].map(a=>[a,r.core.b299CausalPersonalityBias(a)]))).reduce((s,v)=>s+Math.abs(v),0);
assert(lesioned<afterMagnitude*.2+1e-9,'B299 lesion did not suppress its behavioral influence');
r.stop();
console.log(JSON.stringify({pass:true,cycles:diag.cycles,learningUpdates:diag.learningUpdates,verifiedUpdates:diag.verifiedUpdates,autonomousUpdates:diag.autonomousUpdates,personalityInfluence01:diag.personalityInfluence01,personalityStability01:diag.personalityStability01,selfAuthoredDevelopment01:diag.selfAuthoredDevelopment01,causalIntegrity01:diag.causalIntegrity01,beforeMagnitude,afterMagnitude,lesionedMagnitude:lesioned,afterBias}));
