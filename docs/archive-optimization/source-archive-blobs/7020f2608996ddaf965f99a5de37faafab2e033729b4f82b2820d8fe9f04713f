import { OrganismRuntime } from '../src/organism/core/OrganismRuntime.ts';
import { MemoryStateStore } from '../src/organism/persistence/MemoryStateStore.ts';
import { BoundedOperationalJournal } from '../src/organism/persistence/BoundedOperationalJournal.ts';
const assert=(x,m)=>{if(!x)throw new Error(m)};
const r=new OrganismRuntime({stateFile:'b293-test.json',worldStateFile:'b293-world.json',enableLanguage:false,performanceProfile:'balanced',stateStore:new MemoryStateStore(),worldStateStore:new MemoryStateStore(),journal:new BoundedOperationalJournal()});
await r.init();
for(let i=0;i<32;i++) await r.step(i%5===0?'Investigate an uncertain claim, verify it, then revise the plan if the evidence disagrees.':undefined);
const b293=r.core.b293SelfWorldPredictiveDiagnostics();
const b292=r.core.b292IntentTraceDiagnostics();
const b291=r.core.b291UnifiedSelfAgencyDiagnostics();
const b290=r.core.b290RealityGatedNeurodevelopmentDiagnostics();
assert(b293.cycles>=4,'B293 cadence cycles');
assert(b293.learningUpdates>=0,'B293 learning counter valid');
assert(b293.spikes>=0,'B293 spikes counter valid');
assert(Number.isFinite(b293.predictionError01),'B293 prediction error');
assert(b292.recordDepth>0,'B292 intent trace alive');
assert(Number.isFinite(b291.gate01),'B291 gate alive');
assert(Number.isFinite(b290.realityGate01),'B290 gate alive');
const snap=r.core.snapshot();
assert(Boolean(snap.system.selfWorldPredictiveMicrocircuitB293),'B293 persisted');
const before=r.core.b293SelfWorldPredictiveDiagnostics();
r.core.b293SelfWorldPredictiveLesion(.7);
const lesioned=r.core.b293SelfWorldPredictiveDiagnostics();
r.core.b293SelfWorldPredictiveClearLesion();
assert(lesioned.lesion01>.6,'B293 lesion state');
console.log(JSON.stringify({pass:true,tick:r.core.snapshot().tick,b293:{cycles:b293.cycles,learningUpdates:b293.learningUpdates,spikes:b293.spikes,predictionError01:b293.predictionError01,causalConfidence01:b293.causalConfidence01,lesionChanged:lesioned.lesion01!==before.lesion01},b292:{recordDepth:b292.recordDepth,continuity01:b292.continuity01},b291:{mode:b291.mode,gate01:b291.gate01,autonomyShare01:b291.autonomyShare01},b290:{mode:b290.mode,realityGate01:b290.realityGate01}}));
r.stop();
