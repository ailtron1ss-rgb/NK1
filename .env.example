# Copy this file to .env for the Docker Compose launcher.
# The React UI, canonical runtime and persistent app database start without an external model key, but
# generative conversation quality depends on a configured provider.

# Local-only port binding is the safe default. Do not expose publicly without
# an authenticated reverse proxy and suitable network controls.
NK1_BIND_ADDR=127.0.0.1

# Internal Caddy -> runtime credential. Loopback-only default is for local use.
# If you change NK1_BIND_ADDR, replace this with a long random secret first.
NEURO_API_TOKEN=nk1-local-compose-internal-token-change-me

# Optional Gemini provider.
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_VISION_ENABLED=false
GEMINI_VISION_MODEL=

# Optional OpenAI-compatible local model server, for example llama.cpp.
# Use host.docker.internal when the model server runs on the Docker host.
LLAMA_CPP_URL=
LLAMA_CPP_MODEL=local-model

# Optional Kobold-compatible backend. If using one on the host, set:
# KOBOLD_URL=http://host.docker.internal:5001
KOBOLD_URL=http://127.0.0.1:5001
LLM_TIMEOUT_MS=15000

# Runtime guardrails (defaults shown).
NEURO_MAX_BODY_BYTES=1048576
NEURO_REQUEST_TIMEOUT_MS=20000
NEURO_RATE_LIMIT=120
NEURO_RATE_WINDOW_MS=60000
NEURO_BACKUP_EVERY_SAVES=25

# Optional advanced settings. Keep secrets outside version control.
NEURO_SKILL_SHADOW_SCHEDULER_JSON=
NEURO_SKILL_PROMOTION_APPROVAL_KEYS_JSON=
