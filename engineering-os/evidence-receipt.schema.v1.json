{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neurok.local/schemas/evidence-receipt.v1.json",
  "title": "NeuroK exact-SHA evidence receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "receiptId",
    "recordedAt",
    "repository",
    "branch",
    "commitSha",
    "workstream",
    "taskId",
    "status",
    "command",
    "environment",
    "result"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "receiptId": {
      "type": "string",
      "format": "uuid"
    },
    "recordedAt": {
      "type": "string",
      "format": "date-time"
    },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "branch": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "commitSha": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{40}$"
    },
    "workstream": {
      "type": "string",
      "pattern": "^[A-Z0-9][A-Z0-9._-]{1,31}$"
    },
    "taskId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,95}$"
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED",
        "UNKNOWN"
      ]
    },
    "command": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^(?!.*(?:ghp_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,}|Bearer\\s+\\S+|password\\s*=|api[_-]?key\\s*=)).*$"
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodeVersion",
        "platform",
        "arch"
      ],
      "properties": {
        "nodeVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "platform": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "arch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exitCode",
        "durationMs"
      ],
      "properties": {
        "exitCode": {
          "type": "integer"
        },
        "durationMs": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "artifacts": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "sha256",
          "sizeBytes"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          },
          "sizeBytes": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sha256",
        "split"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "split": {
          "enum": [
            "train",
            "validation",
            "holdout",
            "test"
          ]
        }
      }
    },
    "metrics": {
      "type": "object",
      "maxProperties": 100,
      "additionalProperties": {
        "type": "number"
      }
    }
  }
}
