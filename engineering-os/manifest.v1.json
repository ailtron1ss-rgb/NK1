{
  "schemaVersion": 1,
  "name": "NeuroK Engineering OS",
  "purpose": "Governed multi-agent engineering control plane for repository intelligence, research intake, task coordination, safe patching, evidence, and release provenance.",
  "policy": {
    "defaultTrust": "untrusted",
    "credentials": "environment-or-secret-manager-only",
    "neverPersistSecretValues": true,
    "noAutomaticProductionWrites": true,
    "noSelfApproval": true,
    "immutableHoldouts": true,
    "exactShaEvidence": true,
    "branchIsolation": true,
    "promotionRequiresIndependentVerification": true
  },
  "planes": [
    {
      "id": "repo-intelligence",
      "owner": "GitHub + local CLI",
      "purpose": "Repository tree, import/call graph, branch/PR topology, source provenance, dependency and license inventory."
    },
    {
      "id": "agent-coordination",
      "owner": "Codex Coordinator / taskplane",
      "purpose": "Bounded parallel work claims, file ownership, dependencies, conflict detection and handoff."
    },
    {
      "id": "research-intake",
      "owner": "Firecrawl + TinyFish + Consensus + Context7",
      "purpose": "Primary-source discovery, extraction, literature synthesis and versioned API documentation."
    },
    {
      "id": "tool-bridge",
      "owner": "Connector adapters",
      "purpose": "Capability discovery and policy-checked invocation; never treat connector presence as runtime integration."
    },
    {
      "id": "patch-sandbox",
      "owner": "Local isolated runner / CI",
      "purpose": "Patch digest, touched-line derivation, isolated apply, tests, independent verifier and rollback receipt."
    },
    {
      "id": "evidence-ledger",
      "owner": "Git + CI artifacts",
      "purpose": "Exact-SHA receipts, metrics, test provenance, benchmark holdouts and explicit unknowns."
    },
    {
      "id": "release-forge",
      "owner": "GitHub Actions",
      "purpose": "Reproducible ZIP, SHA-256, SBOM, license gate, clean-room smoke and rollback."
    }
  ],
