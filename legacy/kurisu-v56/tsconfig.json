{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "allowJs": false,
    "noEmit": true,
    "types": [
      "node",
      "react",
      "react-dom"
    ]
  },
  "include": [
    "src",
    "server.ts"
  ]
}
